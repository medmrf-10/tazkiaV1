 0, "pg": 343, "j": "1", "sz": 7671}, {"i": 221, "t": "(فصل) وقد سميت ليلة البراءة", "d": 0, "pg": 348, "j": "1", "sz": 2129}, {"i": 222, "t": "مجلس: في فضائل شهر رمضان", "d": 1, "pg": 5, "j": "2", "sz": 4161}, {"i": 223, "t": "(فصل) اختلف الناس في معنى قوله رمضان", "d": 0, "pg": 7, "j": "2", "sz": 815}, {"i": 224, "t": "فصل في قوله ﷿: ﴿شهر رمضان الذي أنزل فيه القرآن﴾", "d": 0, "pg": 8, "j": "2", "sz": 1354}, {"i": 225, "t": "(فصل: فيما يختص بشهر رمضان من الفضائل)", "d": 0, "pg": 9, "j": "2", "sz": 2937}, {"i": 226, "t": "(فصل) أخبرني أبو نصر عن والده بإسناده", "d": 0, "pg": 11, "j": "2", "sz": 6271}, {"i": 227, "t": "(فصل) رمضان خمسة أحرف", "d": 0, "pg": 15, "j": "2", "sz": 1422}, {"i": 228, "t": "فصل إن آدم سيد البشر (وذكر السادة من كل شيء)", "d": 0, "pg": 15, "j": "2", "sz": 1422}, {"i": 229, "t": "(فصل: في فضائل ليلة القدر)", "d": 0, "pg": 16, "j": "2", "sz": 3125}, {"i": 230, "t": "(فصل) وتلتمس ليلة القدر", "d": 0, "pg": 18, "j": "2", "sz": 2075}, {"i": 231, "t": "(فصل: فهل ليلة الجمعة أفضل أم ليلة القدر؟)", "d": 0, "pg": 19, "j": "2", "sz": 6145}, {"i": 232, "t": "فصل لماذا لم يطلع الله عباده على ليلة القدر", "d": 0, "pg": 21, "j": "2", "sz": 1365}, {"i": 233, "t": "(فصل) الله ﷿ -أعطى المصطفى ﷺ -خمس ليالي", "d": 0, "pg": 21, "j": "2", "sz": 1365}, {"i": 234, "t": "(فصل) والأمارة في أنها ليلة القدر", "d": 0, "pg": 23, "j": "2", "sz": 2463}, {"i": 235, "t": "فصل في صلاة التراويح", "d": 0, "pg": 23, "j": "2", "sz": 854}, {"i": 236, "t": "(فصل) ويستحب لها الجماعة والجهر بالقراءة", "d": 0, "pg": 25, "j": "2", "sz": 1916}, {"i": 237, "t": "(فصل آخر: يختم به ما يتعلق بليلة القدر وجميع شهر رمضان)", "d": 0, "pg": 26, "j": "2", "sz": 3020}, {"i": 238, "t": "[مجلس] في ذكر يوم الفطر", "d": 1, "pg": 28, "j": "2", "sz": 1643}, {"i": 239, "t": "(فصل) وإنما سمى العيد عيدا لأنه يعيد الله إلى عبادة الفرح والسرور في يوم عيدهم", "d": 0, "pg": 29, "j": "2", "sz": 2315}, {"i": 240, "t": "(فصل) وأربعة أيعاد لأربعة أقوام", "d": 0, "pg": 30, "j": "2", "sz": 5858}, {"i": 241, "t": "(فصل) يشترك المؤمن والكافر في العيد", "d": 0, "pg": 34, "j": "2", "sz": 781}, {"i": 242, "t": "(فصل) ليس العيد بلبس الناعمات وأكل الطيبات ومعانقة المستحسنات والتمتع باللذات والشهوات", "d": 0, "pg": 34, "j": "2", "sz": 2798}, {"i": 243, "t": "مجلس في فضائل أيام العشر", "d": 1, "pg": 36, "j": "2", "sz": 2706}, {"i": 244, "t": "فصل فيما ورد في عشر ذي الحجة من كرامات الأنبياء", "d": 0, "pg": 38, "j": "2", "sz": 3605}, {"i": 245, "t": "(فصل) وأما الصلاة الواردة في أيام العشر", "d": 0, "pg": 40, "j": "2", "sz": 1675}, {"i": 246, "t": "(فصل) والعشر لخمسة أنبياء ﵈ -", "d": 0, "pg": 41, "j": "2", "sz": 4186}, {"i": 247, "t": "فصل من أكرم هذه الأيام العشرة أكرمه الله تعالى بعشر كرامات", "d": 0, "pg": 42, "j": "2", "sz": 1638}, {"i": 248, "t": "(فصل) وقد أقسم الله تعالى بـ ﴿الفجر وليال عشر", "d": 0, "pg": 43, "j": "2", "sz": 762}, {"i": 249, "t": "[مجلس] في ذكر يوم التروية", "d": 1, "pg": 45, "j": "2", "sz": 1649}, {"i": 250, "t": "(فصل: في فضل من أحرم بالحج ولبى وقصد البيت وإليه دنا)", "d": 0, "pg": 46, "j": "2", "sz": 4655}, {"i": 251, "t": "(فصل) واختلفوا في تسمية يوم التروية", "d": 0, "pg": 49, "j": "2", "sz": 3534}, {"i": 252, "t": "مجلس في فضائل يوم عرفة", "d": 1, "pg": 52, "j": "2", "sz": 1961}, {"i": 253, "t": "(فصل) قوله: ﴿اليوم أكملت لكم دينكم﴾", "d": 0, "pg": 53, "j": "2", "sz": 1451}, {"i": 254, "t": "(فصل) واختلف العلماء في المعنى الذي لأجله قيل للموقف عرفات، وليوم الوقوف بها عرفة", "d": 0, "pg": 54, "j": "2", "sz": 3239}, {"i": 255, "t": "(فصل: في شرف يوم عرفة وليلته)", "d": 0, "pg": 56, "j": "2", "sz": 4972}, {"i": 256, "t": "(فصل) في تفصيل صيامه وما ورد فيه من الصلوات، وما أمر به من صنوف الدعوات", "d": 0, "pg": 59, "j": "2", "sz": 6390}, {"i": 257, "t": "(فصل) ما أختص به رسول الله ﷺ -من الدعاء في عشية عرفة", "d": 0, "pg": 62, "j": "2", "sz": 1580}, {"i": 258, "t": "(فصل) في دعا جبريل وميكائيل وإسرافيل والخضر وإلياس ﵈ -عشية عرفة", "d": 0, "pg": 63, "j": "2", "sz": 4256}, {"i": 259, "t": "فصل أكثر دعاء المسلم في الموقف", "d": 0, "pg": 64, "j": "2", "sz": 1593}, {"i": 260, "t": "مجلس في فضائل يوم الأضحى ويوم النحر", "d": 1, "pg": 67, "j": "2", "sz": 2476}, {"i": 261, "t": "(فصل) فأما الذكر", "d": 0, "pg": 68, "j": "2", "sz": 4778}, {"i": 262, "t": "(فصل) وأما الدعاء", "d": 0, "pg": 71, "j": "2", "sz": 3886}, {"i": 263, "t": "(فصل) وأما النحر", "d": 0, "pg": 74, "j": "2", "sz": 2589}, {"i": 264, "t": "(فصل) ويستحب إذا خرج المؤمن إلى صلاة العيد في طريق أن يرجع في طريق أخرى", "d": 0, "pg": 76, "j": "2", "sz": 1395}, {"i": 265, "t": "(فصل: في فضيلة يوم النحر والأضحية)", "d": 0, "pg": 77, "j": "2", "sz": 2612}, {"i": 266, "t": "(فصل: في صلاة ليلة الأضحى)", "d": 0, "pg": 79, "j": "2", "sz": 323}, {"i": 267, "t": "(فصل) والأضحية سنة", "d": 0, "pg": 79, "j": "2", "sz": 501}, {"i": 268, "t": "(فصل) وأفضلها الإبل ثم البقر ثم الغنم، ولا يجزئ إلا الجذع من الضأن والثنى مما سواه", "d": 0, "pg": 79, "j": "2", "sz": 2057}, {"i": 269, "t": "(فصل: في ذكر أيام التشريق)", "d": 0, "pg": 81, "j": "2", "sz": 2624}, {"i": 270, "t": "(فصل) وقد سمى الله ﷿ -أشياء في القرآن ذكرا", "d": 0, "pg": 83, "j": "2", "sz": 1327}, {"i": 271, "t": "(فصل) واختلف لم سميت أيام التشريق", "d": 0, "pg": 84, "j": "2", "sz": 1216}, {"i": 272, "t": "(فصل) واختلف في قدر التكبير في هذه الأيام", "d": 0, "pg": 84, "j": "2", "sz": 1918}, {"i": 273, "t": "(فصل) وهذا التكبير الذي ذكرناه في عيد الأضحى في عيد الفطر بل هو آكد في الفطر", "d": 0, "pg": 86, "j": "2", "sz": 687}, {"i": 274, "t": "مجلس في فضائل يوم عاشوراء", "d": 1, "pg": 87, "j": "2", "sz": 5269}, {"i": 275, "t": "(فصل) واختلف العلماء ﵏ -في تسميته بيوم عاشوراء", "d": 0, "pg": 90, "j": "2", "sz": 1441}, {"i": 276, "t": "(فصل) واختلفوا في أي يوم هو من المحرم", "d": 0, "pg": 92, "j": "2", "sz": 1832}, {"i": 277, "t": "فصل من فضائل يوم عاشوراء أن الحسين بن علي -رضي الله تعالى عنهما -قتل فيه", "d": 0, "pg": 92, "j": "2", "sz": 1312}, {"i": 278, "t": "(فصل) وقد طعن قوم على من صام هذا اليوم العظيم", "d": 0, "pg": 93, "j": "2", "sz": 1999}, {"i": 279, "t": "مجلس في فضائل يوم الجمعة", "d": 1, "pg": 95, "j": "2", "sz": 2162}, {"i": 280, "t": "(فصل: في فضائل يوم الجمعة من طريق الآثار)", "d": 0, "pg": 96, "j": "2", "sz": 15635}, {"i": 281, "t": "فصل من اغتسل يوم الجمعة ثم راح", "d": 0, "pg": 100, "j": "2", "sz": 1257}, {"i": 282, "t": "فصل أتاني جبريل في كفه كمأة بيضاء", "d": 0, "pg": 103, "j": "2", "sz": 1168}, {"i": 283, "t": "فصل في يوم الجمعة ساعة لا يوافقها عبد يدعو الله تعالى إلا استجيبت دعوته", "d": 0, "pg": 105, "j": "2", "sz": 1641}, {"i": 284, "t": "(فصل: في الصلاة على النبي ﷺ في يوم الجمعة)", "d": 0, "pg": 107, "j": "2", "sz": 1189}, {"i": 285, "t": "(فصل: فيما يستحب أن يقرأ في صلاة الصبح يوم الجمعة)", "d": 0, "pg": 108, "j": "2", "sz": 1246}, {"i": 286, "t": "(فصل: في تسميته بيوم الجمعة)", "d": 0, "pg": 109, "j": "2", "sz": 681}, {"i": 287, "t": "(فصل) وجميع ما ذكرناه من صيام الأشهر والأضحية والعبادات من الصلاة والأذكار وغير ذلك", "d": 0, "pg": 109, "j": "2", "sz": 1904}, {"i": 288, "t": "(فصل) وأما الإخلاص", "d": 0, "pg": 110, "j": "2", "sz": 4094}, {"i": 289, "t": "(فصل) وينبغي لكل متعبد وعارف أن يحذر في جميع أحواله من الرياء ورؤية الخلق والعجب", "d": 0, "pg": 113, "j": "2", "sz": 10349}, {"i": 290, "t": "القسم الرابع في فضائل الأعمال", "d": 0, "pg": 121, "j": "2", "sz": 72}, {"i": 291, "t": "باب في ذكر فضائل أيام الأسبوع والأيام البيض وما ورد في صيام ذلك", "d": 1, "pg": 123, "j": "2", "sz": 3036}, {"i": 292, "t": "(فصل) وأما صيام الأيام البيض ففيها فضل كثير", "d": 0, "pg": 125, "j": "2", "sz": 2965}, {"i": 293, "t": "باب في صيام الدهر وما لمن صامه من الثواب والأجر", "d": 0, "pg": 127, "j": "2", "sz": 1829}, {"i": 294, "t": "(فصل: في فضل الصيام في الجملة)", "d": 0, "pg": 129, "j": "2", "sz": 2948}, {"i": 295, "t": "(فصل) وأما أوراد الليل والحث على قيامه", "d": 0, "pg": 131, "j": "2", "sz": 4854}, {"i": 296, "t": "(فصل) وأما صلاة رسول الله ﷺ المذكورة في المتفق عليه", "d": 0, "pg": 135, "j": "2", "sz": 2183}, {"i": 297, "t": "(فصل آخر: في صلاة الليل)", "d": 0, "pg": 137, "j": "2", "sz": 2441}, {"i": 298, "t": "(فصل: في فضل الصلاة بين العشاءين)", "d": 0, "pg": 139, "j": "2", "sz": 2406}, {"i": 299, "t": "(فصل) وأما الركعتان قبل صلاة المغرب", "d": 0, "pg": 141, "j": "2", "sz": 697}, {"i": 300, "t": "(فصل آخر) في ذكر ما ورد فعله بين العشاءين", "d": 0, "pg": 141, "j": "2", "sz": 5748}, {"i": 301, "t": "(فصل: في ذكر الصلاة بعد العشاء الآخرة)", "d": 0, "pg": 144, "j": "2", "sz": 605}, {"i": 302, "t": "(فصل) وأما الوتر فالأفضل فيه آخر الليل", "d": 0, "pg": 145, "j": "2", "sz": 1871}, {"i": 303, "t": "(فصل) ومن أوتر أول الليل ثم قام إلى التهجد فهل يفسخ وتره أم يصلي ما يشاء من غير أن يفسخه", "d": 0, "pg": 146, "j": "2", "sz": 862}, {"i": 304, "t": "(فصل: في دعاء الوتر)", "d": 0, "pg": 147, "j": "2", "sz": 813}, {"i": 305, "t": "(فصل) وإذا كان ممن يصلي بالليل وغلبه النعاس، فالأولى له أن ينام", "d": 0, "pg": 148, "j": "2", "sz": 4161}, {"i": 306, "t": "(فصل) وأما قيام الليل، فعمل الأقوياء الذين سبقت لهم منه العناية", "d": 0, "pg": 151, "j": "2", "sz": 951}, {"i": 307, "t": "(فصل) ومن استكملت غفلته، وأحاطت به خطيئاته", "d": 0, "pg": 151, "j": "2", "sz": 1704}, {"i": 308, "t": "(فصل) ومن أنعم عليه بقيام الليل وفعل شيء من النوافل، فليجتهد في المداومة عليه من القدرة وعدم العذر", "d": 0, "pg": 152, "j": "2", "sz": 399}, {"i": 309, "t": "(فصل) ويستحب لمن قام من الليل للتهجد أن يقول", "d": 0, "pg": 152, "j": "2", "sz": 2244}, {"i": 310, "t": "(فصل) ويستحب إذا قام لصلاة الليل أن يفتح صلاته بركعتين خفيفتين", "d": 0, "pg": 154, "j": "2", "sz": 429}, {"i": 311, "t": "(فصل) ويستحب ألا ينام حتى يقرأ ثلثمائة آية", "d": 0, "pg": 154, "j": "2", "sz": 829}, {"i": 312, "t": "(فصل) والذي يستعان به على قيام الليل أشياء", "d": 0, "pg": 154, "j": "2", "sz": 1879}, {"i": 313, "t": "(فصل) ويستحب لمن قام الليل أن ينام آخره لوجهين", "d": 0, "pg": 156, "j": "2", "sz": 1614}, {"i": 314, "t": "(فصل) فإن فاته قيام الليل بنوم أو شغل، فإن قضاه ما بين طلوع الشمس إلى زوالها كان كمن صلى في وقته في الليل", "d": 0, "pg": 157, "j": "2", "sz": 765}, {"i": 315, "t": "(فصل) فقد تحصل من هذه الجملة أن أوراد الليل خمسة", "d": 0, "pg": 157, "j": "2", "sz": 596}, {"i": 316, "t": "(فصل) وأما أوراد النهار فخمسة أيضا", "d": 1, "pg": 158, "j": "2", "sz": 326}, {"i": 317, "t": "(فصل) وأما الورد الأول من النهار", "d": 0, "pg": 158, "j": "2", "sz": 4121}, {"i": 318, "t": "(فصل) وأما الورد الثاني: فصلاة الضحى", "d": 0, "pg": 161, "j": "2", "sz": 1224}, {"i": 319, "t": "(فصل) وأما عدد صلاة الضحى، فأقلها ركعتان، وأعدلها ثمان ركعات، وأكثرها اثنتا عشرة ركعة", "d": 0, "pg": 162, "j": "2", "sz": 2075}, {"i": 320, "t": "(فصل) وأما وقتها", "d": 0, "pg": 163, "j": "2", "sz": 571}, {"i": 321, "t": "(فصل) وأما الذي يقرأ فيها", "d": 0, "pg": 164, "j": "2", "sz": 545}, {"i": 322, "t": "(فصل) وقد ورد عن بعض الصحابة ﵃ إنكار صلاة الضحى", "d": 0, "pg": 164, "j": "2", "sz": 782}, {"i": 323, "t": "(فصل) وأما الورد الثالث: فالصلاة قبل الظهر وبعدها", "d": 0, "pg": 165, "j": "2", "sz": 724}, {"i": 324, "t": "(فصل) وأما الورد الرابع: ففيما بين الظهر والعصر", "d": 0, "pg": 165, "j": "2", "sz": 1420}, {"i": 325, "t": "(فصل) وقد ورد حديث جامع للنوافل في هذه الأوقات", "d": 0, "pg": 166, "j": "2", "sz": 1428}, {"i": 326, "t": "(فصل) وأما الورد الخامس، بعد صلاة العصر إلى غروب الشمس", "d": 0, "pg": 167, "j": "2", "sz": 496}, {"i": 327, "t": "باب في الصلوات الخمس وبيان أوقاتها وأعدادها وسنتها وفضائلها", "d": 1, "pg": 168, "j": "2", "sz": 102}, {"i": 328, "t": "(فصل) الصلوات المكتوبة خمس", "d": 0, "pg": 168, "j": "2", "sz": 615}, {"i": 329, "t": "(فصل) والأصل في وجوبها", "d": 0, "pg": 168, "j": "2", "sz": 1551}, {"i": 330, "t": "(فصل: في ذكر من صلى هذه الصلوات أولا قبل نبينا ﷺ)", "d": 0, "pg": 169, "j": "2", "sz": 620}, {"i": 331, "t": "(فصل) وأول ما وجب من الصلوات على نبينا ﷺ وأمر بفعلها، صلاة الفجر والمغرب", "d": 0, "pg": 170, "j": "2", "sz": 652}, {"i": 332, "t": "(فصل: في بيان وقت صلاة الفجر)", "d": 0, "pg": 170, "j": "2", "sz": 1917}, {"i": 333, "t": "(فصل) وأما الظهر", "d": 0, "pg": 171, "j": "2", "sz": 1676}, {"i": 334, "t": "(فصل) وهذا الذي ذكرنا من الأقدام ونصب العمود، يختلف في الشتاء والصيف", "d": 0, "pg": 173, "j": "2", "sz": 820}, {"i": 335, "t": "(فصل: في معرفة الأقدام)", "d": 0, "pg": 173, "j": "2", "sz": 1089}, {"i": 336, "t": "(فصل) وذكر بعضهم صفة أخرى", "d": 0, "pg": 174, "j": "2", "sz": 984}, {"i": 337, "t": "(فصل) وقد ذكر بعض شيوخنا لذلك صفة أخرى", "d": 0, "pg": 174, "j": "2", "sz": 1203}, {"i": 338, "t": "(فصل) ومعرفة الزوال على هذه الصفات والتحديد ليس هو بأمر حتم", "d": 0, "pg": 175, "j": "2", "sz": 1009}, {"i": 339, "t": "(فصل) ومعرفة الزوال على التحقيق أمر يدق ويصعب", "d": 0, "pg": 175, "j": "2", "sz": 1206}, {"i": 340, "t": "(فصل) فإذا عرفت الزوال وأردت أن تعرف القبلة فاجعل ظلك على يسارك", "d": 0, "pg": 176, "j": "2", "sz": 315}, {"i": 341, "t": "(فصل) وأما وقت العصر", "d": 0, "pg": 176, "j": "2", "sz": 390}, {"i": 342, "t": "(فصل) فإذا غاب الشفق دخل وقت العشاء الآخرة", "d": 0, "pg": 177, "j": "2", "sz": 893}, {"i": 343, "t": "(فصل) وأما السنن الراتبة مع هذه الصلوات الخمس فثلاث عشرة ركعة", "d": 0, "pg": 177, "j": "2", "sz": 1933}, {"i": 344, "t": "(فصل: في فضائل الصلوات الخمس)", "d": 0, "pg": 179, "j": "2", "sz": 2731}, {"i": 345, "t": "(فصل: في الخروج إلى المسجد، وفضل الجماعة والخشوع في الصلاة)", "d": 0, "pg": 181, "j": "2", "sz": 5156}, {"i": 346, "t": "(فصل: في المحافظة عليها وما ورد من العقوبة على من ضيعها)", "d": 0, "pg": 185, "j": "2", "sz": 2699}, {"i": 347, "t": "(فصل) الصلاة خطرها عظيم، وأمرها جسيم", "d": 0, "pg": 187, "j": "2", "sz": 6649}, {"i": 348, "t": "فصل مكروهات الصلاة", "d": 0, "pg": 189, "j": "2", "sz": 1507}, {"i": 349, "t": "(فصل) وينبغي لكل مصل أن يقدم النية لصلاته", "d": 0, "pg": 191, "j": "2", "sz": 6295}, {"i": 350, "t": "(فصل: فيما يختص بالإمام)", "d": 0, "pg": 196, "j": "2", "sz": 5078}, {"i": 351, "t": "(فصل) وينبغي للإمام ألا يدخل في الصلاة ولا يكبر حتى ينوي الإمامة بقلبه", "d": 0, "pg": 199, "j": "2", "sz": 3951}, {"i": 352, "t": "(فصل) ويجب على المأموم أن ينوي الائتمام", "d": 0, "pg": 201, "j": "2", "sz": 910}, {"i": 353, "t": "(فصل) وينبغي للمأموم أيضا ألا يسبق الإمام في التكبير", "d": 0, "pg": 202, "j": "2", "sz": 4678}, {"i": 354, "t": "(فصل) ويجب على من رأى من يقصر في صلاته ويسقط أركانها وواجباتها وآدابها أن يعظه ويعلمه وينصحه", "d": 0, "pg": 205, "j": "2", "sz": 4069}, {"i": 355, "t": "(فصل) ويجب على المؤذن أن يصلح من لسانه ما لا يلحن في الشهادتين، ويكون عارفا بالأوقات، وألا يؤذن إلا بعد دخول الوقت", "d": 0, "pg": 207, "j": "2", "sz": 600}, {"i": 356, "t": "(فصل) فرحم الله من أقبل على صلاته خاشعا خاضعا ذليلا لله عز وجل", "d": 0, "pg": 208, "j": "2", "sz": 2908}, {"i": 357, "t": "(فصل) وأما صلاة الخاصة لإيقاظ الخاشعين المراقبين", "d": 0, "pg": 209, "j": "2", "sz": 3825}, {"i": 358, "t": "باب نشير فيه إلى صلاة الجمعة والعيدين وصلاة الاستسقاء والكسوف والخوف والقصر والجمع وصلاة الجنازة مختصرا", "d": 1, "pg": 212, "j": "2", "sz": 147}, {"i": 359, "t": "(فصل) أما صلاة الجمعة", "d": 0, "pg": 212, "j": "2", "sz": 2390}, {"i": 360, "t": "(فصل) وأما صلاة العيدين", "d": 0, "pg": 213, "j": "2", "sz": 2225}, {"i": 361, "t": "(فصل) وأما صلاة الاستسقاء", "d": 0, "pg": 215, "j": "2", "sz": 3369}, {"i": 362, "t": "(فصل) وأما صلاة الكسوف", "d": 0, "pg": 217, "j": "2", "sz": 1827}, {"i": 363, "t": "(فصل) وأما صلاة الخوف", "d": 0, "pg": 218, "j": "2", "sz": 2944}, {"i": 364, "t": "(فصل) وأما قصر الصلاة", "d": 0, "pg": 220, "j": "2", "sz": 2369}, {"i": 365, "t": "(فصل) وأما الجمع بين الصلاتين", "d": 0, "pg": 222, "j": "2", "sz": 2190}, {"i": 366, "t": "(فصل) وأما الصلاة على الجنازة", "d": 0, "pg": 223, "j": "2", "sz": 4715}, {"i": 367, "t": "فصول فيما يفعل بمن حضره الموت وكيفية غسله وتكفينه وتحنيطه ودفنه", "d": 1, "pg": 227, "j": "2", "sz": 106}, {"i": 368, "t": "(فصل) يستحب لكل مؤمن موقن بالموت عاقل محصل أن يكثر ذكر الموت", "d": 0, "pg": 227, "j": "2", "sz": 2401}, {"i": 369, "t": "(فصل) فإذا مرض المؤمن استحبت عيادته", "d": 0, "pg": 229, "j": "2", "sz": 2424}, {"i": 370, "t": "(فصل) ثم يسارع في غسله وتجهيزه وتكفينه ودفنه", "d": 0, "pg": 230, "j": "2", "sz": 6065}, {"i": 371, "t": "(فصل) في ذكر فضائل الصلوات في أيام الأسبوع ولياليه", "d": 1, "pg": 235, "j": "2", "sz": 1400}, {"i": 372, "t": "(فصل: في ذكر صلاة يوم الأحد)", "d": 0, "pg": 236, "j": "2", "sz": 790}, {"i": 373, "t": "(فصل: في ذكر صلاة يوم الاثنين)", "d": 0, "pg": 236, "j": "2", "sz": 726}, {"i": 374, "t": "(فصل: في ذكر صلاة يوم الثلاثاء)", "d": 0, "pg": 237, "j": "2", "sz": 400}, {"i": 375, "t": "(فصل: في ذكر صلاة يوم الأربعاء)", "d": 0, "pg": 237, "j": "2", "sz": 463}, {"i": 376, "t": "(فصل: في ذكر صلاة يوم الخميس)", "d": 0, "pg": 238, "j": "2", "sz": 454}, {"i": 377, "t": "(فصل: في ذكر صلاة يوم الجمعة)", "d": 0, "pg": 238, "j": "2", "sz": 2504}, {"i": 378, "t": "(فصل: في ذكر صلاة يوم السبت)", "d": 0, "pg": 240, "j": "2", "sz": 419}, {"i": 379, "t": "باب في ذكر صلاة الليالي", "d": 1, "pg": 241, "j": "2", "sz": 66}, {"i": 380, "t": "(فصل: في ذكر فضل صلاة ليلة الأحد)", "d": 0, "pg": 241, "j": "2", "sz": 697}, {"i": 381, "t": "(فصل: في ذكر فضل صلاة ليلة الاثنين)", "d": 0, "pg": 241, "j": "2", "sz": 1109}, {"i": 382, "t": "(فصل: في ذكر فضل صلاة ليلة الثلاثاء)", "d": 0, "pg": 242, "j": "2", "sz": 274}, {"i": 383, "t": "(فصل: في ذكر فضل صلاة ليلة الأربعاء)", "d": 0, "pg": 242, "j": "2", "sz": 344}, {"i": 384, "t": "(فصل: في ذكر فضل صلاة ليلة الخميس)", "d": 0, "pg": 242, "j": "2", "sz": 437}, {"i": 385, "t": "(فصل: في ذكر صلاة ليلة الجمعة)", "d": 0, "pg": 243, "j": "2", "sz": 731}, {"i": 386, "t": "(فصل: في ذكر فضل صلاة ليلة السبت)", "d": 0, "pg": 243, "j": "2", "sz": 285}, {"i": 387, "t": "(فصل) وقد ذكرنا في مجلس التوبة", "d": 0, "pg": 244, "j": "2", "sz": 484}, {"i": 388, "t": "(فصل: في ذكر فضل صلاة التسبيح)", "d": 0, "pg": 244, "j": "2", "sz": 1909}, {"i": 389, "t": "(فصل: في صلاة الاستخارة ودعائها للسفر وغيره)", "d": 0, "pg": 245, "j": "2", "sz": 3239}, {"i": 390, "t": "(فصل: في حرز المسافر من كل سارق وسبع ومؤذ)", "d": 0, "pg": 247, "j": "2", "sz": 1347}, {"i": 391, "t": "(فصل: في ذكر صلاة الكفاية)", "d": 0, "pg": 248, "j": "2", "sz": 670}, {"i": 392, "t": "(فصل: في ذكر صلاة الخصماء)", "d": 0, "pg": 249, "j": "2", "sz": 614}, {"i": 393, "t": "(فصل: في صلاة العتقاء في شوال)", "d": 0, "pg": 249, "j": "2", "sz": 1208}, {"i": 394, "t": "(فصل: في فضل الصلاة لرفع عذاب القبر)", "d": 0, "pg"