{"id": 3274, "slug": "أصناف-المغرورين", "title": "أصناف المغرورين", "author": "أبو حامد الغزالي", "death": "505", "toc": [{"i": 0, "t": "﷽", "d": 0, "pg": 21, "j": null, "sz": 63}, {"i": 1, "t": "مقدمة المؤلف", "d": 0, "pg": 21, "j": null, "sz": 885}, {"i": 2, "t": "غرور الكافر", "d": 0, "pg": 25, "j": null, "sz": 381}, {"i": 3, "t": "وعلاج هذا الغرور شيئان", "d": 0, "pg": 25, "j": null, "sz": 1006}, {"i": 4, "t": "فصل فيمن يشاركون الكفار غرورهم", "d": 0, "pg": 26, "j": null, "sz": 71}, {"i": 5, "t": "من المؤمنين بربهم", "d": 0, "pg": 26, "j": null, "sz": 488}, {"i": 6, "t": "ما سبب هذا الغرور", "d": 0, "pg": 27, "j": null, "sz": 1349}, {"i": 7, "t": "ومم ينشأ هذا الغرور", "d": 0, "pg": 28, "j": null, "sz": 445}, {"i": 8, "t": "فصل فى غرور عصاة المؤمنين", "d": 0, "pg": 29, "j": null, "sz": 66}, {"i": 9, "t": "وهم من يتكلون على عفو الله ويهملون العمل", "d": 0, "pg": 29, "j": null, "sz": 328}, {"i": 10, "t": "منشأ ذاك الغرور", "d": 0, "pg": 29, "j": null, "sz": 1120}, {"i": 11, "t": "فصل فيمن اغتر بحسناته مع قلتها وكثرة سيئاته", "d": 0, "pg": 31, "j": null, "sz": 447}, {"i": 12, "t": "فصل فى غرور من يظن أن طاعته أكثر من معاصيه", "d": 0, "pg": 31, "j": null, "sz": 394}, {"i": 13, "t": "فصل فى بيان المغرورين وأقسام كل صنف", "d": 0, "pg": 32, "j": null, "sz": 77}, {"i": 14, "t": "الصنف الأول", "d": 1, "pg": 36, "j": null, "sz": 53}, {"i": 15, "t": "من المغرورين العلماء", "d": 1, "pg": 36, "j": null, "sz": 85}, {"i": 16, "t": "الفرقة الأولى", "d": 1, "pg": 36, "j": null, "sz": 1070}, {"i": 17, "t": "الفرقة الثانية", "d": 1, "pg": 37, "j": null, "sz": 908}, {"i": 18, "t": "الفرقة الثالثة", "d": 1, "pg": 38, "j": null, "sz": 1881}, {"i": 19, "t": "الفرقة الرابعة", "d": 1, "pg": 40, "j": null, "sz": 762}, {"i": 20, "t": "الفرقة الخامسة", "d": 1, "pg": 41, "j": null, "sz": 1819}, {"i": 21, "t": "الفرقة السادسة", "d": 1, "pg": 43, "j": null, "sz": 870}, {"i": 22, "t": "الفرقة السابعة", "d": 1, "pg": 44, "j": null, "sz": 1413}, {"i": 23, "t": "الفرقة الثامنة", "d": 1, "pg": 45,