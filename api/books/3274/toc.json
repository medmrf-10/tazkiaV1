{"id": 3274, "slug": "أصناف-المغرورين", "title": "أصناف المغرورين", "author": "أبو حامد الغزالي", "death": "505", "toc": [{"i": 0, "t": "﷽", "d": 0, "pg": 1}, {"i": 1, "t": "مقدمة المؤلف", "d": 0, "pg": 1}, {"i": 2, "t": "غرور الكافر", "d": 0, "pg": 2}, {"i": 3, "t": "وعلاج هذا الغرور شيئان", "d": 0, "pg": 2}, {"i": 4, "t": "فصل فيمن يشاركون الكفار غرورهم", "d": 0, "pg": 3}, {"i": 5, "t": "من المؤمنين بربهم", "d": 0, "pg": 3}, {"i": 6, "t": "ما سبب هذا الغرور", "d": 0, "pg": 4}, {"i": 7, "t": "ومم ينشأ هذا الغرور", "d": 0, "pg": 5}, {"i": 8, "t": "فصل فى غرور عصاة المؤمنين", "d": 0, "pg": 6}, {"i": 9, "t": "وهم من يتكلون على عفو الله ويهملون العمل", "d": 0, "pg": 6}, {"i": 10, "t": "منشأ ذاك الغرور", "d": 0, "pg": 6}, {"i": 11, "t": "فصل فيمن اغتر بحسناته مع قلتها وكثرة سيئاته", "d": 0, "pg": 8}, {"i": 12, "t": "فصل فى غرور من يظن أن طاعته أكثر من معاصيه", "d": 0, "pg": 8}, {"i": 13, "t": "فصل فى بيان المغرورين وأقسام كل صنف", "d": 0, "pg": 9}, {"i": 14, "t": "الصنف الأول", "d": 1, "pg": 10}, {"i": 15, "t": "من المغرورين العلماء", "d": 1, "pg": 10}, {"i": 16, "t": "الفرقة الأولى", "d": 1, "pg": 10}, {"i": 17, "t": "الفرقة الثانية", "d": 1, "pg": 11}, {"i": 18, "t": "الفرقة الثالثة", "d": 1, "pg": 12}, {"i": 19, "t": "الفرقة الرابعة", "d": 1, "pg": 14}, {"i": 20, "t": "الفرقة الخامسة", "d": 1, "pg": 15}, {"i": 21, "t": "الفرقة السادسة", "d": 1, "pg": 17}, {"i": 22, "t": "الفرقة السابعة", "d": 1, "pg": 18}, {"i": 23, "t": "الفرقة الثامنة", "d": 1, "pg": 19}, {"i": 24, "t": "الفرقة التاسعة", "d": 1, "pg": 20}, {"i": 25, "t": "الفرقة العاشرة", "d": 1, "pg": 20}, {"i": 26, "t": "الفرقة الحادية عشرة", "d": 1, "pg": 22}, {"i": 27, "t": "الصنف الثانى", "d": 1, "pg": 24}, {"i": 28, "t": "من المغرورين أرباب العبادات والأعمال", "d": 1, "pg": 24}, {"i": 29, "t": "الفرقة الأولى", "d": 1, "pg": 24}, {"i": 30, "t": "الفرقة الثانية", "d": 1, "pg": 25}, {"i": 31, "t": "الفرقة الثالثة", "d": 1, "pg": 25}, {"i": 32, "t": "الفرقة الرابعة", "d": 1, "pg": 26}, {"i": 33, "t": "الفرقة الخا