البصر يكون بذهولهما عن الحقائق", "d": 1, "pg": 173}, {"i": 64, "t": "لا يتمكن العشق إلا مع واقف جامد", "d": 1, "pg": 175}, {"i": 65, "t": "الاعتراف بالتقصير أنجح في الحوائج", "d": 1, "pg": 178}, {"i": 66, "t": "أي لب أوغل في النظر مدح على قدر فهمه", "d": 1, "pg": 180}, {"i": 67, "t": "لا يزيد المؤمن عمره إلا خيرا", "d": 1, "pg": 182}, {"i": 68, "t": "طوبى لمن عرف المسبب وتعلق به", "d": 1, "pg": 183}, {"i": 69, "t": "المؤمن لا يبالغ في الذنوب", "d": 1, "pg": 185}, {"i": 70, "t": "أفضل الأشياء التزيد من العلم", "d": 1, "pg": 187}, {"i": 71, "t": "الله يمن عليكم أن هداكم للإيمان", "d": 1, "pg": 189}, {"i": 72, "t": "شرعنا مضبوط الأصول محروس القواعد", "d": 1, "pg": 191}, {"i": 73, "t": "السعيد من لازم التقوى", "d": 1, "pg": 199}, {"i": 74, "t": "انهيال الابتلاء على المؤمن", "d": 1, "pg": 200}, {"i": 75, "t": "يريد اختبارك ليعرف أسرارك", "d": 1, "pg": 202}, {"i": 76, "t": "اجتلاب الصالح ودفع المؤذي", "d": 1, "pg": 204}, {"i": 77, "t": "من تأمل عواقب المعاصي رآها قبيحة", "d": 1, "pg": 206}, {"i": 78, "t": "لا يصلح الأنس إلا بملازمة التقوى", "d": 1, "pg": 207}, {"i": 79, "t": "كتمان الأمور فعل الحازم", "d": 1, "pg": 209}, {"i": 80, "t": "الاحتراز من الذنوب", "d": 1, "pg": 211}, {"i": 81, "t": "ندر من تطرقه البلايا مع التقوى", "d": 1, "pg": 213}, {"i": 82, "t": "لا ينال لذة المعاصي إلا سكران الغفلة", "d": 1, "pg": 215}, {"i": 83, "t": "إنما عزلة العالم عن الشر", "d": 1, "pg": 216}, {"i": 84, "t": "للذنوب عواقب سيئة", "d": 1, "pg": 220}, {"i": 85, "t": "اعرفوا عظمة الناهي", "d": 1, "pg": 222}, {"i": 86, "t": "تسأل الله حاجاتها وتنسى جناياتها", "d": 1, "pg": 223}, {"i": 87, "t": "ما عرف الله ولا من خاف منه", "d": 1, "pg": 224}, {"i": 88, "t": "المعرفة التي توجب الرضا والصبر", "d": 1, "pg": 226}, {"i": 89, "t": "صفة العارف", "d": 1, "pg": 228}, {"i": 90, "t": "لا تبع عز التقوى بذل المعاصي", "d": 1, "pg": 230}, {"i": 91, "t": "ثبتت حكمة الله في حكمه وملكه", "d": 1, "pg": 233}, {"i": 92, "t": "أعجب الأشياء مجاهدة النفس", "d": 1, "pg": 234}, {"i": 93, "t": "البدار البدار قبل الفوات", "d": 1, "pg": 236}, {"i": 94, "t": "تخليط أرباب الآخرة", "d": 1, "pg": 237}, {"i": 95, "t": "أنفع المشايخ في صحبته العامل بعلمه", "d": 1, "pg": 238}, {"i": 96, "t": "إن الله ﷿ يمهل ليبلو صبر الصابر", "d": 1, "pg": 240}, {"i": 97, "t": "الجمع بين العلم والمعاملة", "d": 1, "pg": 242}, {"i": 98, "t": "نعوذ بالله من طول الأمل", "d": 1, "pg": 244}, {"i": 99, "t": "أخذ الإشارات من الأشعار", "d": 1, "pg": 245}, {"i": 100, "t": "الورع الأخذ بالأحوط في اتقاء الشبهات", "d": 1, "pg": 247}, {"i": 101, "t": "إن العقوبة بالمرصاد", "d": 1, "pg": 249}, {"i": 102, "t": "اجتهاد العاقل فيما يصلحه لازم", "d": 1, "pg": 250}, {"i": 103, "t": "لو صحت النفوس لذابت من خوف الله أو لغابت في محبته", "d": 1, "pg": 255}, {"i": 104, "t": "الواجب الصبر وإن كان الدعاء مشروعا", "d": 1, "pg": 257}, {"i": 105, "t": "زاد الصبر", "d": 1, "pg": 258}, {"i": 106, "t": "المدعو مالك حكيم", "d": 1, "pg": 260}, {"i": 107, "t": "رتبة العلماء على الزهاد", "d": 1, "pg": 261}, {"i": 108, "t": "أصلح الأمور الاعتدال في كل شيء", "d": 1, "pg": 263}, {"i": 109, "t": "الفكر يدل على أشرف المقامات", "d": 1, "pg": 265}, {"i": 110, "t": "ما أكمل العلم والمال في المؤمن", "d": 1, "pg": 268}, {"i": 111, "t": "الفقه أفضل العلوم", "d": 1, "pg": 270}, {"i": 112, "t": "على العاقل أن يحذر الهوى", "d": 1, "pg": 271}, {"i": 113, "t": "آفة الصداقة الحسد", "d": 1, "pg": 274}, {"i": 114, "t": "من أحسن فيما مضى يحسن فيما بقي", "d": 1, "pg": 276}, {"i": 115, "t": "الشره في تحصيل الأشياء يفوت مقصودها", "d": 1, "pg": 278}, {"i": 116, "t": "إن للخلوة تأثيرات تبين في الجلوة", "d": 1, "pg": 283}, {"i": 117, "t": "من عرف جريان الأقدار ثبت لها", "d": 1, "pg": 285}, {"i": 118, "t": "الابتلاء لمعرفة الصبر وإظهار الفضل", "d": 1, "pg": 286}, {"i": 119, "t": "عليكم من العمل بما تطيقون", "d": 1, "pg": 288}, {"i": 120, "t": "لا خير في لذة من بعدها النار", "d": 1, "pg": 290}, {"i": 121, "t": "لذتا الحس والعقل", "d": 1, "pg": 292}, {"i": 122, "t": "تعليم حفظ العلم", "d": 1, "pg": 294}, {"i": 123, "t": "أعظم المحن الاغترار بالسلامة بعد الذنب", "d": 1, "pg": 297}, {"i": 124, "t": "للباطل جولة وللحق صولة", "d": 1, "pg": 300}, {"i": 125, "t": "البلاء على العارف", "d": 1, "pg": 305}, {"i": 126, "t": "ميزان العدل تبين فيها الذرة", "d": 1, "pg": 307}, {"i": 127, "t": "ابتعد عن أسباب الفتنة", "d": 1, "pg": 309}, {"i": 128, "t": "البشر كلهم في حرب", "d": 1, "pg": 311}, {"i": 129, "t": "الدنيا فخ والجاهل يقع بأول نظرة", "d": 1, "pg": 312}, {"i": 130, "t": "للذنوب تأثيرات قبيحة", "d": 1, "pg": 313}, {"i": 131, "t": "من يتوكل على الله فهو حسبه", "d": 1, "pg": 316}, {"i": 132, "t": "نظف طرق الإجابة من أدران الذنوب", "d": 1, "pg": 318}, {"i": 133, "t": "الاستعداد للموت", "d": 1, "pg": 319}, {"i": 134, "t": "الحذر من المعاصي", "d": 1, "pg": 321}, {"i": 135, "t": "من عظم الله عظم الله قدره", "d": 1, "pg": 322}, {"i": 136, "t": "ملازمة مجلس الإنابة", "d": 1, "pg": 324}, {"i": 137, "t": "دموع الندم تطفئ نيران الذنوب", "d": 1, "pg": 326}, {"i": 138, "t": "اقبل نصحي يا مخدوعا بغرضه", "d": 1, "pg": 327}, {"i": 139, "t": "حسن جزاء من خاف مقام ربه", "d": 1, "pg": 330}, {"i": 140, "t": "المحنة على من طلب اللذة من طريق الحرام", "d": 1, "pg": 332}, {"i": 141, "t": "الحق ﷿ أقرب إلى عبده من حبل الوريد", "d": 1, "pg": 333}, {"i": 142, "t": "على الإنسان ألا ينافس بلذات الدنيا", "d": 1, "pg": 334}, {"i": 143, "t": "معاذ الله إنه ربي", "d": 1, "pg": 337}, {"i": 144, "t": "قطع أسباب الفتن", "d": 1, "pg": 339}, {"i": 145, "t": "من بالغ في الاحتراز من المعاصي سلم", "d": 1, "pg": 340}, {"i": 146, "t": "البلايا على مقادير الرجال", "d": 1, "pg": 342}, {"i": 147, "t": "اللازم في العالم طلب المهم", "d": 1, "pg": 344}, {"i": 148, "t": "إذا صح قصد العالم استراح من التكلف", "d": 1, "pg": 346}, {"i": 149, "t": "الدنيا دار ابتلاء واختيار", "d": 1, "pg": 347}, {"i": 150, "t": "العالم الذي يتكسب يصون عرضه ودينه", "d": 1, "pg": 349}, {"i": 151, "t": "الهوى يسوق إلى العصيان", "d": 1, "pg": 351}, {"i": 152, "t": "التكسب والقناعة", "d": 1, "pg": 352}, {"i": 153, "t": "مدار الأمر كله على العقل", "d": 1, "pg": 354}, {"i": 154, "t": "الواجب على العاقل أن يتبع الدليل", "d": 1, "pg": 357}, {"i": 155, "t": "أكل الأرباح في الصبر", "d": 1, "pg": 359}, {"i": 156, "t": "الرقائق والنظر في سير الصالحين", "d": 1, "pg": 361}, {"i": 157, "t": "لا حرج في الترخص ما لم يخرق إجماعا", "d": 1, "pg": 363}, {"i": 158, "t": "احتياج الخلق بعضهم إلى بعض", "d": 1, "pg": 365}, {"i": 159, "t": "عليك بالقناعة مهما أمكن", "d": 1, "pg": 366}, {"i": 160, "t": "قل لن يصيبنا إلا ما كتب الله لنا", "d": 1, "pg": 369}, {"i": 161, "t": "الأحمق يتقاوى على الله", "d": 1, "pg": 370}, {"i": 162, "t": "السعيد من ذل لله", "d": 1, "pg": 372}, {"i": 163, "t": "الاقتداء بصاحب الشرع", "d": 1, "pg": 373}, {"i": 164, "t": "جاء الدخل من الفلسفة والرهبانية", "d": 1, "pg": 379}, {"i": 165, "t": "أعوذ بالله من صحبة البطالين", "d": 1, "pg": 380}, {"i": 166, "t": "التصنيف المفيد ومراحل عمر العالم", "d": 1, "pg": 382}, {"i": 167, "t": "العادات غلبت على الناس", "d": 1, "pg": 385}, {"i": 168, "t": "الواجب على العالم صيانة علمه", "d": 1, "pg": 388}, {"i": 169, "t": "ثمرات العلم", "d": 1, "pg": 391}, {"i": 170, "t": "أصلح المقامات التوسط", "d": 1, "pg": 394}, {"i": 171, "t": "علو الهمة", "d": 1, "pg": 396}, {"i": 172, "t": "لا بد من مغالطة ليتم العيش", "d": 1, "pg": 400}, {"i": 173, "t": "في تعليم التدبير", "d": 1, "pg": 403}, {"i": 174, "t": "بادر موسم الزرع", "d": 1, "pg": 406}, {"i": 175, "t": "المؤمن بين الخوف والرجاء", "d": 1, "pg": 408}, {"i": 176, "t": "عدد أحاديث رسول الله صلى الله عليه وسلم", "d": 1, "pg": 409}, {"i": 177, "t": "اللغة منطق العرب", "d": 1, "pg": 413}, {"i": 178, "t": "العاقل ينظر في العواقب، والغافل لا يرى إلا الحاضر", "d": 1, "pg": 415}, {"i": 179, "t": "الآمال أكبر من الآجال", "d": 1, "pg": 417}, {"i": 180, "t": "ما أقل من يعمل لله خالصا!", "d": 1, "pg": 418}, {"i": 181, "t": "اعملوا فكل ميسر لما خلق له", "d": 1, "pg": 419}, {"i": 182, "t": "وفي أنفسكم أفلا تبصرون؟", "d": 1, "pg": 420}, {"i": 183, "t": "العلماء حفظة الشريعة", "d": 1, "pg": 421}, {"i": 184, "t": "العاقل من يحفظ جانب الله عز وجل", "d": 1, "pg": 423}, {"i": 185, "t": "الأصول والصور", "d": 1, "pg": 427}, {"i": 186, "t": "تحصيل المرادات لا يتم إلا بالاحتيال", "d": 1, "pg": 430}, {"i": 187, "t": "في حفظ السر", "d": 1, "pg": 433}, {"i": 188, "t": "ما رأيت أصعب على النفس من الحفظ للعلم!", "d": 1, "pg": 435}, {"i": 189, "t": "العزلة إنما هي للعالم والزاهد", "d": 1, "pg": 437}, {"i": 190, "t": "الاستعداد للموت", "d": 1, "pg": 440}, {"i": 191, "t": "على العاقل أن يكف عن التطلع إلى ما لا يطيق", "d": 1, "pg": 442}, {"i": 192, "t": "لذة العاقل ولذة الجاهل", "d": 1, "pg": 444}, {"i": 193, "t": "أصل كل محنة قياس صفات الخالق على صفات المخلوقين", "d": 1, "pg": 446}, {"i": 194, "t": "كل نفيس يكثر التعب في تحصيله", "d": 1, "pg": 448}, {"i": 195, "t": "المؤمن هو الكامل الإيمان", "d": 1, "pg": 451}, {"i": 196, "t": "أضر ما على العوام المتكلمون", "d": 1, "pg": 453}, {"i": 197, "t": "الأجساد إلى البلى والأوراح إلى راحة", "d": 1, "pg": 455}, {"i": 198, "t": "حفظ اللسان", "d": 1, "pg": 457}, {"i": 199, "t": "حكمة الله أوفى من كل حكيم", "d": 1, "pg": 458}, {"i": 200, "t": "على المؤمن التصبر مهما أمكن", "d": 1, "pg": 461}, {"i": 201, "t": "الغفلة المحمودة والغفلة المذمومة", "d": 1, "pg": 462}, {"i": 202, "t": "من راءى الخلق عبدهم وهو لا يعلم", "d": 1, "pg": 464}, {"i": 203, "t": "كل المعاصي قبيحة", "d": 1, "pg": 467}, {"i": 204, "t": "التحذير من الإعجاب بالنفس", "d": 1, "pg": 469}, {"i": 205, "t": "الغضبان كالسكران لا يؤاخذ بما يقول", "d": 1, "pg": 471}, {"i": 206, "t": "لا ينبغي أن تعادي أحدا", "d": 1, "pg": 473}, {"i": 207, "t": "كامل العقل من يتلمح العواقب", "d": 1, "pg": 475}, {"i": 208, "t": "بقدر صعود الإنسان في الدنيا تنزل مرتبته في الآخرة", "d": 1, "pg": 477}, {"i": 209, "t": "أكثر الناس يمشون مع العادة", "d": 1, "pg": 480}, {"i": 210, "t": "الكمال عزيز", "d": 1, "pg": 481}, {"i": 211, "t": "من أراد السلامة ما عرف التكليف", "d": 1, "pg": 482}, {"i": 212, "t": "من الابتلاء العظيم إقامة الرجل في غير مقامه", "d": 1, "pg": 483}, {"i": 213, "t": "العالم الذي يجمع المال من وجوه قبيحة", "d": 1, "pg": 485}, {"i": 214, "t": "من عرف شرف الوجود يحصل أفضل الموجود", "d": 1, "pg": 488}, {"i": 215, "t": "البدار البدار فقد قرب الرحيل", "d": 1, "pg": 490}, {"i": 216, "t": "رضا الرسول ﷺ عن ربه", "d": 1, "pg": 491}, {"i": 217, "t": "أكثر شهوات الحس النساء", "d": 1, "pg": 494}, {"i": 218, "t": "كل شخص شغله الله بفن", "d": 1, "pg": 496}, {"i": 219, "t": "علم الحديث هو الشريعة", "d": 1, "pg": 497}, {"i": 220, "t": "مسند الإمام أحمد فيه الصحيح وغيره", "d": 1, "pg": 500}, {"i": 221, "t": "الأنفة من الرذائل", "d": 1, "pg": 502}, {"i": 222, "t": "قد تبغت العقوبات، وقد يؤخرها الحلم", "d": 1, "pg": 504}, {"i": 223, "t": "أسعد الناس من له قوت بقدر الكفاية", "d": 1, "pg": 506}, {"i": 224, "t": "التجلد عن المصائب", "d": 1, "pg": 509}, {"i": 225, "t": "منازل المؤمنين في الآخرة على قدرهم", "d": 1, "pg": 511}, {"i": 226, "t": "الجزاء على قدر العمل", "d": 1, "pg": 514}, {"i": 227, "t": "الحكمة من أخذ الجزية", "d": 1, "pg": 516}, {"i": 228, "t": "ينبغي للعالم أن يأخذ طرفا من كل علم", "d": 1, "pg": 517}, {"i": 229, "t": "الكبر والحسد يغطيان نور العقل", "d": 1, "pg": 519}, {"i": 230, "t": "من الصالحين من غلب عليه الرفق ومنهم من غلب عليه الخوف", "d": 1, "pg": 521}, {"i": 231, "t": "العلم معرفة الأصول", "d": 1, "pg": 522}, {"i": 232, "t": "سبب تنغيص العيش فوات الحظوظ العاجلة", "d": 1, "pg": 525}, {"i": 233, "t": "عد منع الله إياك عطاء لك", "d": 1, "pg": 527}, {"i": 234, "t": "التعلل بالأقدار", "d": 1, "pg": 529}, {"i": 235, "t": "الشريعة هي الطريق", "d": 1, "pg": 532}, {"i": 236, "t": "لا مرحبا بسرور عاد بالضرر", "d": 1, "pg": 534}, {"i": 237, "t": "ليس للأمل منتهى ولا للاغترار حد", "d": 1, "pg": 538}, {"i": 238, "t": "سبب تخليط العقائد قياس الحاضر على الغائب", "d": 1, "pg": 540}, {"i": 239, "t": "ليكن هم العاقل إقامة الحق والرضا به", "d": 1, "pg": 544}, {"i": 240, "t": "لا تضيع لحظة من عمرك", "d": 1, "pg": 546}, {"i": 241, "t": "الإعراض عن الله سبب الهموم والغموم", "d": 1, "pg": 548}, {"i": 242, "t": "ما العيش إلا في الجنة", "d": 1, "pg": 550}, {"i": 243, "t": "على من صحب سلطان أن يكون ظاهره وباطنه سواء", "d": 1, "pg": 551}, {"i": 244, "t": "الحرص والأمل", "d": 1, "pg": 554}, {"i": 245, "t": "كبير السن ينكح الصغيرة", "d": 1, "pg": 555}, {"i": 246, "t": "العاقل من راقب العواقب", "d": 1, "pg": 557}, {"i": 247, "t": "ليس إلا المعرفة بالجملة", "d": 1, "pg": 559}, {"i": 248, "t": "العجب لمن يترخص في المخالطة", "d": 1, "pg": 560}, {"i": 249, "t": "من البله أن تبادر عدوا بالمخاصمة", "d": 1, "pg": 563}, {"i": 250, "t": "الخلاص من المحن بالتوبة والدعاء", "d": 1, "pg": 564}, {"i": 251, "t": "العلماء وأقسامهم والجهال وأقسامهم", "d": 1, "pg": 565}, {"i": 252, "t": "السلف تشاغلوا بالقرآن والعلم", "d": 1, "pg": 568}, {"i": 253, "t": "الحزم في كتمان الحب والبغض", "d": 1, "pg": 570}, {"i": 254, "t": "لا تظهر بغضك لمن تبغضه", "d": 1, "pg": 572}, {"i": 255, "t": "خادم السلطان يخشى على دينه ودنياه", "d": 1, "pg": 574}, {"i": 256, "t": "من أنف الذل تجافى عن منن الأنذال", "d": 1, "pg": 576}, {"i": 257, "t": "يتضمن وصية للشباب", "d": 1, "pg": 577}, {"i": 258, "t": "ضرر علم الكلام على العوام", "d": 1, "pg": 579}, {"i": 259, "t": "أشد الناس جهلا منهوم باللذات", "d": 1, "pg": 581}, {"i": 260, "t": "الهوى والتسويف والاغترار بالرحمة", "d": 1, "pg": 583}, {"i": 261, "t": "الإعراض عما يحرك الفخر والزهو والعجب", "d": 1, "pg": 585}, {"i": 262, "t": "العزلة حمية", "d": 1, "pg": 587}, {"i": 263, "t": "أسباب الهداية", "d": 1, "pg": 589}, {"i": 264, "t": "عجبت لمن يعجب بصورته وينسى مبدأ أمره", "d": 1, "pg": 591}, {"i": 265, "t": "نصائح لأهل العلم وطلابه", "d": 1, "pg": 592}, {"i": 266, "t": "زيارة المقابر ومفاوضة الكتب", "d": 1, "pg": 594}, {"i": 267, "t": "صفات أولياء الله", "d": 1, "pg": 596}, {"i": 268, "t": "يبذلون العرض دون الغرض", "d": 1, "pg": 598}, {"i": 269, "t": "الإنفاق في بناء المساجد والأربطة", "d": 1, "pg": 600}, {"i": 270, "t": "الرياء يضيع العمل", "d": 1, "pg": 603}, {"i": 271, "t": "متى وقع الترخص حمل إلى غيره", "d": 1, "pg": 605}, {"i": 272, "t": "حكمة الخالق وراء العقول", "d": 1, "pg": 607}, {"i": 273, "t": "من أوغل في السن فليعتبر بما فقد", "d": 1, "pg": 609}, {"i": 274, "t": "متى تكامل العقل فقدت لذة الدنيا", "d": 1, "pg": 611}, {"i": 275, "t": "من قدح في البعث قدح في الحكمة", "d": 1, "pg": 612}, {"i": 276, "t": "تجلي الخالق سبحانه", "d": 1, "pg": 614}, {"i": 277, "t": "عالم معاند وجاهل مهمل", "d": 1, "pg": 615}, {"i": 278, "t": "للنفس ذخائر في البدن", "d": 1, "pg": 617}, {"i": 279, "t": "زهاد زماننا أهل رياء ونفاق", "d": 1, "pg": 619}, {"i": 280, "t": "على المؤمن أن يصون نفسه", "d": 1, "pg": 620}, {"i": 281, "t": "على المؤمن أن يحترز مما يمكن وقوعه", "d": 1, "pg": 622}, {"i": 282, "t": "السعيد من اهتم لحفظ دينه وقنع من الدنيا باليسير", "d": 1, "pg": 624}, {"i": 283, "t": "الموفق من طلاب العلم", "d": 1, "pg": 626}, {"i": 284, "t": "التثبت والمشاورة", "d": 1, "pg": 627}, {"i": 285, "t": "من لم يحترز بعقله هلك بعقله", "d": 1, "pg": 629}, {"i": 286, "t": "بإنعامك المتقدم أتوسل إليك", "d": 1, "pg": 631}, {"i": 287, "t": "المحمود من الأشياء المتوسط", "d": 1, "pg": 633}, {"i": 288, "t": "إذا أردت أن تصادق أحدا فاختبره", "d": 1, "pg": 637}, {"i": 289, "t": "العجب لمطلق يؤثر القيد ومستريح يؤثر التعب", "d": 1, "pg": 639}, {"i": 290, "t": "إذا تم علم الإنسان لم يدل بعمله", "d": 1, "pg": 641}, {"i": 291, "t": "الخوف بعد التوبة", "d": 1, "pg": 644}, {"i": 292, "t": "نعوذ بالله من سوء الفهم", "d": 1, "pg": 646}, {"i": 293, "t": "نعوذ بالله من رياء يبطل أعمالنا", "d": 1, "pg": 648}, {"i": 294, "t": "الدنيا وضعت للبلاء", "d": 1, "pg": 650}, {"i": 295, "t": "تحذير العلماء من مخالطة السلاطين", "d": 1, "pg": 652}, {"i": 296, "t": "جمهور الناس خرج من ربقة العبودية", "d": 1, "pg": 655}, {"i": 297, "t": "عاقبة الصبر الجميل جميلة", "d": 1, "pg": 656}, {"i": 298, "t": "الإحسان إلى الزوجة عمل الرجال", "d": 1, "pg": 659}, {"i": 299, "t": "من أراد اجتماع همه فعليه بالعزلة", "d": 1, "pg": 662}, {"i": 300, "t": "لا تسبوا الدهر", "d": 1, "pg": 664}, {"i": 301, "t": "زيادة الثواب في الآخرة بقدر العمل في الدنيا", "d": 1, "pg": 666}, {"i": 302, "t": "الأمر بحفظ السر", "d": 1, "pg": 667}, {"i": 303, "t": "تسبيح المتيقظين", "d": 1, "pg": 669}, {"i": 304, "t": "لا يصفون الاشتغال بالآخرة إلا بالانقطاع عن الخلق", "d": 1, "pg": 670}, {"i": 