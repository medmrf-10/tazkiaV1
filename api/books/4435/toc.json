الله لنا", "d": 1, "pg": 233, "j": null, "sz": 1026}, {"i": 161, "t": "الأحمق يتقاوى على الله", "d": 1, "pg": 233, "j": null, "sz": 430}, {"i": 162, "t": "السعيد من ذل لله", "d": 1, "pg": 234, "j": null, "sz": 689}, {"i": 163, "t": "الاقتداء بصاحب الشرع", "d": 1, "pg": 234, "j": null, "sz": 6312}, {"i": 164, "t": "جاء الدخل من الفلسفة والرهبانية", "d": 1, "pg": 239, "j": null, "sz": 198}, {"i": 165, "t": "أعوذ بالله من صحبة البطالين", "d": 1, "pg": 240, "j": null, "sz": 1468}, {"i": 166, "t": "التصنيف المفيد ومراحل عمر العالم", "d": 1, "pg": 241, "j": null, "sz": 2179}, {"i": 167, "t": "العادات غلبت على الناس", "d": 1, "pg": 243, "j": null, "sz": 2440}, {"i": 168, "t": "الواجب على العالم صيانة علمه", "d": 1, "pg": 245, "j": null, "sz": 2574}, {"i": 169, "t": "ثمرات العلم", "d": 1, "pg": 247, "j": null, "sz": 3519}, {"i": 170, "t": "أصلح المقامات التوسط", "d": 1, "pg": 249, "j": null, "sz": 1295}, {"i": 171, "t": "علو الهمة", "d": 1, "pg": 250, "j": null, "sz": 3251}, {"i": 172, "t": "لا بد من مغالطة ليتم العيش", "d": 1, "pg": 253, "j": null, "sz": 2355}, {"i": 173, "t": "في تعليم التدبير", "d": 1, "pg": 255, "j": null, "sz": 2828}, {"i": 174, "t": "بادر موسم الزرع", "d": 1, "pg": 257, "j": null, "sz": 710}, {"i": 175, "t": "المؤمن بين الخوف والرجاء", "d": 1, "pg": 258, "j": null, "sz": 536}, {"i": 176, "t": "عدد أحاديث رسول الله صلى الله عليه وسلم", "d": 1, "pg": 258, "j": null, "sz": 3459}, {"i": 177, "t": "اللغة منطق العرب", "d": 1, "pg": 261, "j": null, "sz": 1092}, {"i": 178, "t": "العاقل ينظر في العواقب، والغافل لا يرى إلا الحاضر", "d": 1, "pg": 262, "j": null, "sz": 1290}, {"i": 179, "t": "الآمال أكبر من الآجال", "d": 1, "pg": 263, "j": null, "sz": 693}, {"i": 180, "t": "ما أقل من يعمل لله خالصا!", "d": 1, "pg": 264, "j": null, "sz": 1325}, {"i": 181, "t": "اعملوا فكل ميسر لما خلق له", "d": 1, "pg": 265, "j": null, "sz": 554}, {"i": 182, "t": "وفي أنفسكم أفلا تبصرون؟", "d": 1, "pg": 265, "j": null, "sz": 567}, {"i": 183, "t": "العلماء حفظة الشريعة", "d": 1, "pg": 265, "j": null, "sz": 1306}, {"i": 184, "t": "العاقل من يحفظ جانب الله عز وجل", "d": 1, "pg": 266, "j": null, "sz": 3040}, {"i": 185, "t": "الأصول والصور", "d": 1, "pg": 269, "j": null, "sz": 4044}, {"i": 186, "t": "تحصيل المرادات لا يتم إلا بالاحتيال", "d": 1, "pg": 271, "j": null, "sz": 738}, {"i": 187, "t": "في حفظ السر", "d": 1, "pg": 273, "j": null, "sz": 1889}, {"i": 188, "t": "ما رأيت أصعب على النفس من الحفظ للعلم!", "d": 1, "pg": 274, "j": null, "sz": 1049}, {"i": 189, "t": "العزلة إنما هي للعالم والزاهد", "d": 1, "pg": 275, "j": null, "sz": 2008}, {"i": 190, "t": "الاستعداد للموت", "d": 1, "pg": 277, "j": null, "sz": 1941}, {"i": 191, "t": "على العاقل أن يكف عن التطلع إلى ما لا يطيق", "d": 1, "pg": 278, "j": null, "sz": 1155}, {"i": 192, "t": "لذة العاقل ولذة الجاهل", "d": 1, "pg": 279, "j": null, "sz": 890}, {"i": 193, "t": "أصل كل محنة قياس صفات الخالق على صفات المخلوقين", "d": 1, "pg": 280, "j": null, "sz": 1456}, {"i": 194, "t": "كل نفيس يكثر التعب في تحصيله", "d": 1, "pg": 281, "j": null, "sz": 1904}, {"i": 195, "t": "المؤمن هو الكامل الإيمان", "d": 1, "pg": 283, "j": null, "sz": 1414}, {"i": 196, "t": "أضر ما على العوام المتكلمون", "d": 1, "pg": 284, "j": null, "sz": 1668}, {"i": 197, "t": "الأجساد إلى البلى والأوراح إلى راحة", "d": 1, "pg": 285, "j": null, "sz": 1070}, {"i": 198, "t": "حفظ اللسان", "d": 1, "pg": 286, "j": null, "sz": 487}, {"i": 199, "t": "حكمة الله أوفى من كل حكيم", "d": 1, "pg": 287, "j": null, "sz": 3302}, {"i": 200, "t": "على المؤمن التصبر مهما أمكن", "d": 1, "pg": 289, "j": null, "sz": 1126}, {"i": 201, "t": "الغفلة المحمودة والغفلة المذمومة", "d": 1, "pg": 290, "j": null, "sz": 2145}, {"i": 202, "t": "من راءى الخلق عبدهم وهو لا يعلم", "d": 1, "pg": 291, "j": null, "sz": 1751}, {"i": 203, "t": "كل المعاصي قبيحة", "d": 1, "pg": 293, "j": null, "sz": 1830}, {"i": 204, "t": "التحذير من الإعجاب بالنفس", "d": 1, "pg": 294, "j": null, "sz": 1633}, {"i": 205, "t": "الغضبان كالسكران لا يؤاخذ بما يقول", "d": 1, "pg": 295, "j": null, "sz": 1034}, {"i": 206, "t": "لا ينبغي أن تعادي أحدا", "d": 1, "pg": 296, "j": null, "sz": 1142}, {"i": 207, "t": "كامل العقل من يتلمح العواقب", "d": 1, "pg": 297, "j": null, "sz": 1074}, {"i": 208, "t": "بقدر صعود الإنسان في الدنيا تنزل مرتبته في الآخرة", "d": 1, "pg": 298, "j": null, "sz": 3228}, {"i": 209, "t": "أكثر الناس يمشون مع العادة", "d": 1, "pg": 301, "j": null, "sz": 687}, {"i": 210, "t": "الكمال عزيز", "d": 1, "pg": 301, "j": null, "sz": 521}, {"i": 211, "t": "من أراد السلامة ما عرف التكليف", "d": 1, "pg": 302, "j": null, "sz": 876}, {"i": 212, "t": "من الابتلاء العظيم إقامة الرجل في غير مقامه", "d": 1, "pg": 302, "j": null, "sz": 1514}, {"i": 213, "t": "العالم الذي يجمع المال من وجوه قبيحة", "d": 1, "pg": 303, "j": null, "sz": 2176}, {"i": 214, "t": "من عرف شرف الوجود يحصل أفضل الموجود", "d": 1, "pg": 305, "j": null, "sz": 718}, {"i": 215, "t": "البدار البدار فقد قرب الرحيل", "d": 1, "pg": 306, "j": null, "sz": 906}, {"i": 216, "t": "رضا الرسول ﷺ عن ربه", "d": 1, "pg": 307, "j": null, "sz": 2627}, {"i": 217, "t": "أكثر شهوات الحس النساء", "d": 1, "pg": 309, "j": null, "sz": 1055}, {"i": 218, "t": "كل شخص شغله الله بفن", "d": 1, "pg": 310, "j": null, "sz": 704}, {"i": 219, "t": "علم الحديث هو الشريعة", "d": 1, "pg": 310, "j": null, "sz": 1318}, {"i": 220, "t": "مسند الإمام أحمد فيه الصحيح وغيره", "d": 1, "pg": 312, "j": null, "sz": 1658}, {"i": 221, "t": "الأنفة من الرذائل", "d": 1, "pg": 313, "j": null, "sz": 1505}, {"i": 222, "t": "قد تبغت العقوبات، وقد يؤخرها الحلم", "d": 1, "pg": 314, "j": null, "sz": 1309}, {"i": 223, "t": "أسعد الناس من له قوت بقدر الكفاية", "d": 1, "pg": 315, "j": null, "sz": 1944}, {"i": 224, "t": "التجلد عن المصائب", "d": 1, "pg": 317, "j": null, "sz": 1573}, {"i": 225, "t": "منازل المؤمنين في الآخرة على قدرهم", "d": 1, "pg": 318, "j": null, "sz": 2937}, {"i": 226, "t": "الجزاء على قدر العمل", "d": 1, "pg": 320, "j": null, "sz": 1614}, {"i": 227, "t": "الحكمة من أخذ الجزية", "d": 1, "pg": 322, "j": null, "sz": 631}, {"i": 228, "t": "ينبغي للعالم أن يأخذ طرفا من كل علم", "d": 1, "pg": 322, "j": null, "sz": 1901}, {"i": 229, "t": "الكبر والحسد يغطيان نور العقل", "d": 1, "pg": 323, "j": null, "sz": 1505}, {"i": 230, "t": "من الصالحين من غلب عليه الرفق ومنهم من غلب عليه الخوف", "d": 1, "pg": 325, "j": null, "sz": 1113}, {"i": 231, "t": "العلم معرفة الأصول", "d": 1, "pg": 325, "j": null, "sz": 2157}, {"i": 232, "t": "سبب تنغيص العيش فوات الحظوظ العاجلة", "d": 1, "pg": 327, "j": null, "sz": 1690}, {"i": 233, "t": "عد منع الله إياك عطاء لك", "d": 1, "pg": 328, "j": null, "sz": 839}, {"i": 234, "t": "التعلل بالأقدار", "d": 1, "pg": 329, "j": null, "sz": 1954}, {"i": 235, "t": "الشريعة هي الطريق", "d": 1, "pg": 331, "j": null, "sz": 2000}, {"i": 236, "t": "لا مرحبا بسرور عاد بالضرر", "d": 1, "pg": 332, "j": null, "sz": 3502}, {"i": 237, "t": "ليس للأمل منتهى ولا للاغترار حد", "d": 1, "pg": 335, "j": null, "sz": 1221}, {"i": 238, "t": "سبب تخليط العقائد قياس الحاضر على الغائب", "d": 1, "pg": 336, "j": null, "sz": 4849}, {"i": 239, "t": "ليكن هم العاقل إقامة الحق والرضا به", "d": 1, "pg": 339, "j": null, "sz": 1049}, {"i": 240, "t": "لا تضيع لحظة من عمرك", "d": 1, "pg": 340, "j": null, "sz": 1165}, {"i": 241, "t": "الإعراض عن الله سبب الهموم والغموم", "d": 1, "pg": 341, "j": null, "sz": 999}, {"i": 242, "t": "ما العيش إلا في الجنة", "d": 1, "pg": 342, "j": null, "sz": 806}, {"i": 243, "t": "على من صحب سلطان أن يكون ظاهره وباطنه سواء", "d": 1, "pg": 343, "j": null, "sz": 2981}, {"i": 244, "t": "الحرص والأمل", "d": 1, "pg": 345, "j": null, "sz": 621}, {"i": 245, "t": "كبير السن ينكح الصغيرة", "d": 1, "pg": 345, "j": null, "sz": 1522}, {"i": 246, "t": "العاقل من راقب العواقب", "d": 1, "pg": 347, "j": null, "sz": 1549}, {"i": 247, "t": "ليس إلا المعرفة بالجملة", "d": 1, "pg": 348, "j": null, "sz": 908}, {"i": 248, "t": "العجب لمن يترخص في المخالطة", "d": 1, "pg": 349, "j": null, "sz": 2926}, {"i": 249, "t": "من البله أن تبادر عدوا بالمخاصمة", "d": 1, "pg": 351, "j": null, "sz": 997}, {"i": 250, "t": "الخلاص من المحن بالتوبة والدعاء", "d": 1, "pg": 352, "j": null, "sz": 984}, {"i": 251, "t": "العلماء وأقسامهم والجهال وأقسامهم", "d": 1, "pg": 352, "j": null, "sz": 2856}, {"i": 252, "t": "السلف تشاغلوا بالقرآن والعلم", "d": 1, "pg": 355, "j": null, "sz": 2103}, {"i": 253, "t": "الحزم في كتمان الحب والبغض", "d": 1, "pg": 356, "j": null, "sz": 1426}, {"i": 254, "t": "لا تظهر بغضك لمن تبغضه", "d": 1, "pg": 357, "j": null, "sz": 1033}, {"i": 255, "t": "خادم السلطان يخشى على دينه ودنياه", "d": 1, "pg": 358, "j": null, "sz": 829}, {"i": 256, "t": "من أنف الذل تجافى عن منن الأنذال", "d": 1, "pg": 359, "j": null, "sz": 800}, {"i": 257, "t": "يتضمن وصية للشباب", "d": 1, "pg": 359, "j": null, "sz": 1089}, {"i": 258, "t": "ضرر علم الكلام على العوام", "d": 1, "pg": 360, "j": null, "sz": 935}, {"i": 259, "t": "أشد الناس جهلا منهوم باللذات", "d": 1, "pg": 361, "j": null, "sz": 1245}, {"i": 260, "t": "الهوى والتسويف والاغترار بالرحمة", "d": 1, "pg": 362, "j": null, "sz": 1258}, {"i": 261, "t": "الإعراض عما يحرك الفخر والزهو والعجب", "d": 1, "pg": 363, "j": null, "sz": 1209}, {"i": 262, "t": "العزلة حمية", "d": 1, "pg": 364, "j": null, "sz": 1647}, {"i": 263, "t": "أسباب الهداية", "d": 1, "pg": 366, "j": null, "sz": 1911}, {"i": 264, "t": "عجبت لمن يعجب بصورته وينسى مبدأ أمره", "d": 1, "pg": 367, "j": null, "sz": 776}, {"i": 265, "t": "نصائح لأهل العلم وطلابه", "d": 1, "pg": 368, "j": null, "sz": 2184}, {"i": 266, "t": "زيارة المقابر ومفاوضة الكتب", "d": 1, "pg": 369, "j": null, "sz": 920}, {"i": 267, "t": "صفات أولياء الله", "d": 1, "pg": 370, "j": null, "sz": 1335}, {"i": 268, "t": "يبذلون العرض دون الغرض", "d": 1, "pg": 371, "j": null, "sz": 908}, {"i": 269, "t": "الإنفاق في بناء المساجد والأربطة", "d": 1, "pg": 372, "j": null, "sz": 2242}, {"i": 270, "t": "الرياء يضيع العمل", "d": 1, "pg": 374, "j": null, "sz": 1118}, {"i": 271, "t": "متى وقع الترخص حمل إلى غيره", "d": 1, "pg": 375, "j": null, "sz": 1456}, {"i": 272, "t": "حكمة الخالق وراء العقول", "d": 1, "pg": 376, "j": null, "sz": 1773}, {"i": 273, "t": "من أوغل في السن فليعتبر بما فقد", "d": 1, "pg": 377, "j": null, "sz": 375}, {"i": 274, "t": "متى تكامل العقل فقدت لذة الدنيا", "d": 1, "pg": 378, "j": null, "sz": 447}, {"i": 275, "t": "من قدح في البعث قدح في الحكمة", "d": 1, "pg": 378, "j": null, "sz": 895}, {"i": 276, "t": "تجلي الخالق سبحانه", "d": 1, "pg": 379, "j": null, "sz": 1212}, {"i": 277, "t": "عالم معاند وجاهل مهمل", "d": 1, "pg": 380, "j": null, "sz": 1452}, {"i": 278, "t": "للنفس ذخائر في البدن", "d": 1, "pg": 381, "j": null, "sz": 1149}, {"i": 279, "t": "زهاد زماننا أهل رياء ونفاق", "d": 1, "pg": 382, "j": null, "sz": 581}, {"i": 280, "t": "على المؤمن أن يصون نفسه", "d": 1, "pg": 382, "j": null, "sz": 671}, {"i": 281, "t": "على المؤمن أن يحترز مما يمكن وقوعه", "d": 1, "pg": 383, "j": null, "sz": 1131}, {"i": 282, "t": "السعيد من اهتم لحفظ دينه وقنع من الدنيا باليسير", "d": 1, "pg": 384, "j": null, "sz": 1402}, {"i": 283, "t": "الموفق من طلاب العلم", "d": 1, "pg": 385, "j": null, "sz": 526}, {"i": 284, "t": "التثبت والمشاورة", "d": 1, "pg": 385, "j": null, "sz": 838}, {"i": 285, "t": "من لم يحترز بعقله هلك بعقله", "d": 1, "pg": 386, "j": null, "sz": 1906}, {"i": 286, "t": "بإنعامك المتقدم أتوسل إليك", "d": 1, "pg": 387, "j": null, "sz": 1083}, {"i": 287, "t": "المحمود من الأشياء المتوسط", "d": 1, "pg": 388, "j": null, "sz": 3910}, {"i": 288, "t": "إذا أردت أن تصادق أحدا فاختبره", "d": 1, "pg": 391, "j": null, "sz": 1295}, {"i": 289, "t": "العجب لمطلق يؤثر القيد ومستريح يؤثر التعب", "d": 1, "pg": 392, "j": null, "sz": 1635}, {"i": 290, "t": "إذا تم علم الإنسان لم يدل بعمله", "d": 1, "pg": 393, "j": null, "sz": 2266}, {"i": 291, "t": "الخوف بعد التوبة", "d": 1, "pg": 395, "j": null, "sz": 914}, {"i": 292, "t": "نعوذ بالله من سوء الفهم", "d": 1, "pg": 396, "j": null, "sz": 1115}, {"i": 293, "t": "نعوذ بالله من رياء يبطل أعمالنا", "d": 1, "pg": 397, "j": null, "sz": 1930}, {"i": 294, "t": "الدنيا وضعت للبلاء", "d": 1, "pg": 399, "j": null, "sz": 1796}, {"i": 295, "t": "تحذير العلماء من مخالطة السلاطين", "d": 1, "pg": 400, "j": null, "sz": 2143}, {"i": 296, "t": "جمهور الناس خرج من ربقة العبودية", "d": 1, "pg": 402, "j": null, "sz": 787}, {"i": 297, "t": "عاقبة الصبر الجميل جميلة", "d": 1, "pg": 402, "j": null, "sz": 2704}, {"i": 298, "t": "الإحسان إلى الزوجة عمل الرجال", "d": 1, "pg": 404, "j": null, "sz": 2242}, {"i": 299, "t": "من أراد اجتماع همه فعليه بالعزلة", "d": 1, "pg": 406, "j": null, "sz": 1338}, {"i": 300, "t": "لا تسبوا الدهر", "d": 1, "pg": 407, "j": null, "sz": 1289}, {"i": 301, "t": "زيادة الثواب في الآخرة بقدر العمل في الدنيا", "d": 1, "pg": 408, "j": null, "sz": 460}, {"i": 302, "t": "الأمر بحفظ السر", "d": 1, "pg": 408, "j": null, "sz": 433}, {"i": 303, "t": "تسبيح المتيقظين", "d": 1, "pg": 409, "j": null, "sz": 885}, {"i": 304, "t": "لا يصفون الاشتغال بالآخرة إلا بالانقطاع عن الخلق", "d": 1, "pg": 409, "j": null, "sz": 921}, {"i": 305, "t": "يدوم طيب القلب بدوام التقوى", "d": 1, "pg": 410, "j": null, "sz": 767}, {"i": 306, "t": "همة المؤمن متعلقة بالآخرة", "d": 1, "pg": 411, "j": null, "sz": 1454}, {"i": 307, "t": "كمال الصورة اعتدالها", "d": 1, "pg": 412, "j": null, "sz": 890}, {"i": 308, "t": "الحق منزه عن العبث", "d": 1, "pg": 413, "j": null, "sz": 1489}, {"i": 309, "t": "من اضطر أن يعظ سلطانا تلطف معه", "d": 1, "pg": 414, "j": null, "sz": 1533}, {"i": 310, "t": "الحق لا يشتبه بباطل", "d": 1, "pg": 415, "j": null, "sz": 7381}, {"i": 311, "t": "السعيد من انتبه لنفسه", "d": 1, "pg": 422, "j": null, "sz": 1416}, {"i": 312, "t": "ما يسلي عن الدنيا ويهون فراقها", "d": 1, "pg": 424, "j": null, "sz": 772}, {"i": 313, "t": "وهب الله تعالى العقل للإنسان ليثبت عليه الحجة", "d": 1, "pg": 424, "j": null, "sz": 850}, {"i": 314, "t": "ليتزود العبد على قدر طول السفر", "d": 1, "pg": 425, "j": null, "sz": 2323}, {"i": 315, "t": "وإن تعدوا نعمة الله لا تحصوها", "d": 1, "pg": 427, "j": null, "sz": 918}, {"i": 316, "t": "النفس لا بد لها مما تتشاغل به", "d": 1, "pg": 428, "j": null, "sz": 1225}, {"i": 317, "t": "اللهم أرنا الأشياء كما هي", "d": 1, "pg": 429, "j": null, "sz": 2632}, {"i": 318, "t": "الفائدة في خلق ما يؤذي", "d": 1, "pg": 430, "j": null, "sz": 856}, {"i": 319, "t": "كلما أوغلت الفهوم في معرفة الخالق تاهت في محبته", "d": 1, "pg": 431, "j": null, "sz": 1290}, {"i": 320, "t": "في سبب تبذير الولاة", "d": 1, "pg": 432, "j": null, "sz": 767}, {"i": 321, "t": "تحديث العوام بما لا تحتمله قلوبهم مخاطرة", "d": 1, "pg": 433, "j": null, "sz": 967}, {"i": 322, "t": "الرجل هو الذي يحفظ الحدود ويخلص العمل", "d": 1, "pg": 433, "j": null, "sz": 1239}, {"i": 323, "t": "حب الصيت", "d": 1, "pg": 434, "j": null, "sz": 1168}, {"i": 324, "t": "خلق الإنسان ومعه الحسد", "d": 1, "pg": 436, "j": null, "sz": 839}, {"i": 325, "t": "أعظم الضرر كثرة النساء", "d": 1, "pg": 436, "j": null, "sz": 1121}, {"i": 326, "t": "قليل العقل لا يرجى خبره", "d": 1, "pg": 437, "j": null, "sz": 702}, {"i": 327, "t": "النظر في العواقب شأن العقلاء", "d": 1, "pg": 438, "j": null, "sz": 821}, {"i": 328, "t": "يظهر إيمان المؤمن عند الابتلاء", "d": 1, "pg": 438, "j": null, "sz": 1339}, {"i": 329, "t": "لذات الدنيا في ضمنها أكدار", "d": 1, "pg": 439, "j": null, "sz": 1636}, {"i": 330, "t": "من تبع العقل سلم", "d": 1, "pg": 440, "j": null, "sz": 773}, {"i": 331, "t": "العجب لمؤثر شهوات الدنيا", "d": 1, "pg": 441, "j": null, "sz": 1062}, {"i": 332, "t": "رؤية النبي ﷺ في المنام", "d": 1, "pg": 442, "j": null, "sz": 865}, {"i": 333, "t": "العلم كثير والعمر قصير", "d": 1, "pg": 442, "j": null, "sz": 1484}, {"i": 334, "t": "العاقل العالم يسير بين رفيقين: العلم والعقل", "d": 1, "pg": 444, "j": null, "sz": 3154}, {"i": 335, "t": "متى استقام باطنك استقامت لك الأمور", "d": 1, "pg": 446, "j": null, "sz": 2403}, {"i": 336, "t": "المحق لا يطلب إلا الأرفع", "d": 1, "pg": 448, "j": null, "sz": 1525}, {"i": 337, "t": "الاشتغال بصورة العلم دون حقيقته ومقصوده", "d": 1, "pg": 449, "j": null, "sz": 2636}, {"i": 338, "t": "للفقيه أن يطالع من كل فن طرفا", "d": 1, "pg": 451, "j": null, "sz": 1929}, {"i": 339, "t": "همم القدماء من العلماء", "d": 1, "pg": 453, "j": null, "sz": 1359}, {"i": 340, "t": "أثر قلة العقل وترك إعماله", "d": 1, "pg": 454, "j": null, "sz": 1283}, {"i": 341, "t": "رب سر ظهر فكان سبب الهلاك", "d": 1, "pg": 455, "j": null, "sz": 380}, {"i": 342, "t": "عاشق العلم", "d": 1, "pg": 456, "j": null, "sz": 3544}, {"i": 343, "t": "البدن كالراحلة إن لم يرفق بها لم تصل بالراكب", "d": 1, "pg": 458, "j": null, "sz": 1862}, {"i": 344, "t": "إذا تكامل العقل قوي الذكاء والفطنة", "d": 1, "pg": 460, "j": null, "sz": 1145}, {"i": 345, "t": "من رزق اليقظة ينبغي أن يصابر لنيل الفضائل", "d": 1, "pg": 461, "j": null, "sz": 1649}, {"i": 346, "t": "لابد من مخالطة بمقدار", "d": 1, "pg": 462, "j": null, "sz": 1230}, {"i": 347, "t": "من سار مع العقل أمكنه أن يتمتع من الدنيا", "d": 1, "pg": 463, "j": null, "sz": 964}, {"i": 348, "t": "عيش الصديقين وعيش البهائم", "d": 1, "pg": 464, "j": null, "sz": 1072}, {"i": 349, "t": "مقصود الموضوعات وحكمها والمراد منها", "d": 1, "pg": 465, "j": null, "sz": 1414}, {"i": 350, "t": "في مخالطة الأمراء", "d": 1, "pg": 466, "j": null, "sz": 541}, {"i": 351, "t": "العاقل من عمل بمقتضى الحزم", "d": 1, "pg": 466, "j": null, "sz": 1821}, {"i": 352, "t": "هلك الهالكون لقلة الصبر عن المشتهي", "d": 1, "pg": 467, "j": null, "sz": 1684}, {"i": 353, "t": "من رزق همة عالية يعذب بمقدار علوها", "d": 1, "pg": 469, "j": null, "sz": 1382}, {"i": 354, "t": "المصيبة العظمى رضا الإنسان عن نفسه", "d": 1, "pg": 470, "j": null, "sz": 1705}, {"i": 355, "t": "\"فصل ينبغي تأمله:\" الجزاء بالمرصاد", "d": 1, "pg": 471, "j": null, "sz": 3398}, {"i": 356, "t": "محاسبة النفس قبل أن تحاسب", "d": 1, "pg": 474, "j": null, "sz": 3053}, {"i": 357, "t": "عداوة الأقارب صعبة", "d": 1, "pg": 476, "j": null, "sz": 503}, {"i": 358, "t": "المؤمن العاقل لا يلتفت إلى حاسده", "d": 1, "pg": 477, "j": null, "sz": 729}, {"i": 359, "t": "ملاحظته من أهم الأشياء", "d": 1, "pg": 478, "j": null, "sz": 3308}, {"i": 360, "t": "أحوال الناس في العيد تشبه أحوالهم يوم القيامة", "d": 1, "pg": 480, "j": null, "sz": 1465}, {"i": 361, "t": "يتضمن نصيحة للعلماء والزهاد", "d": 1, "pg": 481, "j": null, "sz": 1090}, {"i": 362, "t": "تخليط بعض العلماء والعباد", "d": 1, "pg": 482, "j": null, "sz": 4289}, {"i": 363, "t": "جعل الله لأحوال الآدمي أمثلة ليعتبر بها", "d": 1, "pg": 485, "j": null, "sz": 1035}, {"i": 364, "t": "إنما فضل العقل بتأمل العواقب", "d": 1, "pg": 486, "j": null, "sz": 746}, {"i": 365, "t": "هيهات أن يصح الدين مع تحصيل اللذات", "d": 1, "pg": 487, "j": null, "sz": 804}, {"i": 366, "t": "تفاوت الناس في الفهوم", "d": 1, "pg": 487, "j": null, "sz": 1402}, {"i": 367, "t": "لذة الدنيا شيبت بالنغص", "d": 1, "pg": 489, "j": null, "sz": 1384}, {"i": 368, "t": "من حيل إبليس", "d": 1, "pg": 490, "j": null, "sz": 2059}, {"i": 369, "t": "اغتنام الزمان", "d": 1, "pg": 491, "j": null, "sz": 1602}, {"i": 370, "t": "في معاشرة النساء", "d": 1, "pg": 493, "j": null, "sz": 1181}, {"i": 371, "t": "فضل القناعة", "d": 1, "pg": 494, "j": null, "sz": 1824}, {"i": 372, "t": "التسليم للحكيم", "d": 1, "pg": 496, "j": null, "sz": 1839}, {"i": 373, "t": "من تلمح أحوال الدنيا علم أن مراد الحق اجتنابها", "d": 1, "pg": 497, "j": null, "sz": 719}, {"i": 374, "t": "العاقل يدبر بعقله عيشته في الدنيا", "d": 1, "pg": 498, "j": null, "sz": 1449}, {"i": 375, "t": "المقدمة", "d": 1, "pg": 499, "j": null, "sz": 1153}, {"i": 376, "t": "تميز الآدمي بالعقل", "d": 1, "pg": 500, "j": null, "sz": 1397}, {"i": 377, "t": "معرفة الله بالدليل أول ما ينبغي النظر فيه", "d": 1, "pg": 501, "j": null, "sz": 1573}, {"i": 378, "t": "تدبير اللطيف عبده الضعيف", "d": 1, "pg": 502, "j": null, "sz": 2222}, {"i": 379, "t": "اجتهد ما دام في الوقت سعة", "d": 1, "pg": 504, "j": null, "sz": 1235}, {"i": 380, "t": "النظر في حقيقة الدنيا", "d": 1, "pg": 505, "j": null, "sz": 607}, {"i": 381, "t": "لا تيأس من الخير", "d": 1, "pg": 506, "j": null, "sz": 2462}, {"i": 382, "t": "العزلة أصل كل خير", "d": 1, "pg": 508, "j": null, "sz": 802}, {"i": 383, "t": "اقتنع تعز", "d": 1, "pg": 509, "j": null, "sz": 822}, {"i": 384, "t": "متى صحت التقوى رأيت كل خير", "d": 1, "pg": 509, "j": null, "sz": 209}, {"i": 385, "t": "سمو الهمة إلى الكمال", "d": 1, "pg": 511, "j": null, "sz": 588}, {"i": 386, "t": "الحفظ رأس المال والتصرف ربح", "d": 1, "pg": 511, "j": null, "sz": 515}, {"i": 387, "t": "من أعرض عن العمل منع البركة", "d": 1, "pg": 512, "j": null, "sz": 235}, {"i": 388, "t": "على قدر انتفاعك بالعلم ينتفع السماعون", "d": 1, "pg": 512, "j": null, "sz": 583}, {"i": 389, "t": "عليك بقراءة هذه الكتب", "d": 1, "pg": 512, "j": null, "sz": 547}, {"i": 390, "t": "حسن المدارة", "d": 1, "pg": 513, "j": null, "sz": 398}, {"i": 391, "t": "أد إلى كل ذي حق حقه", "d": 1, "pg": 513, "j": null, "sz": 650}, {"i": 392, "t": "إننا من أولاد أبي بكر الصديق رضي الله عنه", "d": 1, "pg": 514, "j": null, "sz": 983}, {"i": 393, "t": "الفهارس العامة", "d": 1, "pg": 515, "j": null, "sz": 48474}]}